{
  "name": "hao-zhu-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "postbuild": "node scripts/copy-static.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node dist-server/server.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
